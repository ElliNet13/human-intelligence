# Copy this file to .env and edit it.

# Ollama server used for "Forward to AI" and for reading tool definitions.
# Just the server address; the /v1 OpenAI-compatible path is added automatically.
OLLAMA_URL=http://localhost:11434

# Only needed if your Ollama server sits behind something that wants a bearer token.
# OLLAMA_API_KEY=

# Initial model; can be changed later in the UI (gear icon).
OLLAMA_MODEL=mimo_v2.6:latest

# Optional
# PORT=8787
# HOST=0.0.0.0
# API_KEY=          # if set, clients must send "Authorization: Bearer <key>" to /v1/*
